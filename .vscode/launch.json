{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run package/spotify-nest",
      "request": "launch",
      "runtimeArgs": [
        "run-script",
        "start"
      ],
      "runtimeExecutable": "npm",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "type": "node",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/packages/spotify-nest",
      "presentation": {
        "group": ".server"
      }
    },
    {
      "name": "Run package/spotify-next",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/packages/spotify-next",
      "program": "${workspaceFolder}/node_modules/next/dist/bin/next",
      "runtimeArgs": [
        "--inspect"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ],
    }
  ]
}