{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run package/spotify-nest",
      "request": "launch",
      "runtimeArgs": ["run-script", "start"],
      "runtimeExecutable": "npm",
      "skipFiles": ["<node_internals>/**"],
      "type": "node",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/packages/spotify-nest",
      "presentation": {
        "group": ".server"
      }
    }
  ]
}
