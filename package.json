{
  "author": "Onnion",
  "name": "spotify-share-music-generator",
  "scripts": {
    "prepare": "husky",
    "lint:node": "sh ./scripts/lint-node.sh",
    "lint:python": "sh ./scripts/lint-python.sh"
  },
  "bugs": {
    "url": "https://github.com/Onnion/spotify-share-music-generator/issues"
  },
  "homepage": "https://github.com/Onnion/spotify-share-music-generator#readme",
  "keywords": [
    "generator",
    "music",
    "share",
    "spotify"
  ],
  "license": "MIT",
  "lint-staged": {
    "packages/spotify/**/*.{js,jsx,ts,tsx}": "npm run lint:node",
    "packages/video/**/*.py": "npm run lint:python"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Onnion/spotify-share-music-generator.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2"
  }
}
