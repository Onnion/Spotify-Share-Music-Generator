{
  "name": "spotify",
  "version": "1.0.0",
  "description": "A generator for sharing Spotify music",
  "scripts": {
    "start": "nodemon src/index.ts",
    "prod": "node dist/index.js",
    "cleandist": "rimraf dist",
    "build": "npm run cleandist && sucrase ./src -d ./dist --transforms typescript,imports",
    "ts-node": "ts-node",
    "test": "jest",
    "lint": "eslint ."
  },
  "dependencies": {
    "amqplib": "^0.6.0",
    "body-parser": "^1.19.0",
    "express": "^4.17.1",
    "node-spotify-api": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@eslint/json": "^0.12.0",
    "@eslint/markdown": "^6.6.0",
    "@types/node": "^24.0.7",
    "eslint": "^9.30.0",
    "globals": "^16.2.0",
    "rimraf": "^6.0.1",
    "sucrase": "^3.35.0",
    "typescript-eslint": "^8.35.0",
    "@types/amqplib": "^0.5.13",
    "@types/express": "^4.17.6",
    "@types/jest": "^26.0.0",
    "jest": "^26.0.0",
    "nodemon": "^2.0.7",
    "ts-node": "^8.10.2",
    "tslib": "^2.0.0",
    "typescript": "^3.9.3"
  }
}
