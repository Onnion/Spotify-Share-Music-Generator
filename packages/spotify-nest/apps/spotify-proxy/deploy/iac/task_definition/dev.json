[
  {
    "name": "spotify-nestjs",
    "image": "544893998937.dkr.ecr.sa-east-1.amazonaws.com/spotify-nestjs:latest",
    "essential": true,
    "portMappings": [
      {
        "containerPort": 3000,
        "hostPort": 3000,
        "protocol": "tcp"
      }
    ],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/ecs/spotify_nestjs",
        "awslogs-region": "${var.aws_region}",
        "awslogs-stream-prefix": "ecs"
      }
    },
    "environment": [
      {
        "name": "NODE_ENV",
        "value": "${var.environment}"
      }
    ]
  }
]
